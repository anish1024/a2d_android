# A2D cloud deployment settings
#
# Copy to .env, fill the required values, and ensure deploy.sh has been run
# (which writes the supervisord drop-in and restarts the service).
# Never commit .env. Mode 0600.
# =============================================================================

# The root of the a2d-cloud backend source. Relative to this checkout.
A2D_APP_HOME=../../a2d-cloud

# The virtualenv directory, relative to A2D_APP_HOME. Do not change after first run.
A2D_VENV_DIR=.venv

# Runtime data directory (host path). Defaults to A2D_APP_HOME/data; set an
# absolute path (e.g. /var/lib/a2d-cloud/data) to keep state outside the checkout.
A2D_DATA_DIR=../../a2d-cloud/data

# Public origin reached through the Cloudflare Tunnel. No trailing slash.
A2D_PUBLIC_BASE_URL=https://a2d.example.com

# 32+ random bytes: openssl rand -hex 32
A2D_JWT_SECRET=

# Optional: change the bind address/port for uvicorn. App binds to
# A2D_BIND_HOST:A2D_BIND_PORT; cloudflared connects to that address.
# Typical values: 0.0.0.0:8000 (all interfaces, for network access)
# or 127.0.0.1:8000 (localhost-only, never a host port).
A2D_BIND_HOST=0.0.0.0
A2D_BIND_PORT=8000

# Cloudflare Zero Trust tunnel token. Required.
CLOUDFLARE_TUNNEL_TOKEN=

# Backups retention (number of sets to keep on the host).
A2D_BACKUP_KEEP=14

# Tenant control parameters (safe defaults unless you know what you're changing).
A2D_TENANT_CACHE_SIZE=64
A2D_TENANT_IDLE_SECONDS=300
A2D_USER_QUOTA_BYTES=104857600
A2D_ARCHIVE_RETENTION_DAILY=30
A2D_TOMBSTONE_RETENTION_DAYS=90
A2D_MAX_IMPORT_BYTES=10485760

# Login / registration
A2D_ALLOW_REGISTRATION=false
A2D_ACCESS_TTL_SECONDS=900
A2D_REFRESH_TTL_SECONDS=2592000