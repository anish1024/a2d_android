# supervisord drop-in for A2D Cloud (generated by deploy.sh).
# This file lives at /etc/supervisor/conf.d/a2d-cloud.conf.
# It is chmod 0600 so only root and the service user may read it.
#
# Generated paths are resolved from these env vars:
#   A2D_APP_HOME      — where the a2d-cloud backend source lives
#   A2D_VENV_DIR      — the virtualenv directory (default: A2D_APP_HOME/.venv)
#   A2D_DATA_DIR      — runtime data root (default: A2D_APP_HOME/data)
#   A2D_LOG_DIR       — log directory (default: /var/log/a2d-cloud)
#   A2D_RUN_USER      — the service user (default: a2dcloud)
#   A2D_BIND_HOST     — uvicorn listen address (default: 127.0.0.1)
#   A2D_BIND_PORT     — uvicorn listen port (default: 8000)
#   CLOUDFLARE_TUNNEL_TOKEN — from .env (never stored in image)
#
# After editing, reload:
#   supervisorctl reread && supervisorctl update